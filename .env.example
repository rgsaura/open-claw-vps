# OpenClaw Environment Configuration Template
#
# Copy this file to .env and configure with your values:
#   cp .env.example .env
#   nano .env
#
# SECURITY: Never commit .env to version control!

# =============================================================================
# PORTS
# =============================================================================
# HTTP port (redirects to HTTPS)
PORT=8080

# HTTPS port (SSL)
SSL_PORT=8443

# =============================================================================
# DOMAIN
# =============================================================================
# Your domain name (leave empty for localhost)
DOMAIN=

# =============================================================================
# SECURITY
# =============================================================================
# Generate with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Admin credentials
# For password hash, use: openssl passwd -1 -bcrypt "yourpassword"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# =============================================================================
# CLOUDFLARE CONFIGURATION
# =============================================================================
# Create API token at: https://dash.cloudflare.com/profile/api-tokens
# Recommended permissions: Zone - DNS:Edit, Account - User Details:Read
CLOUDFLARE_API_TOKEN=

# =============================================================================
# TELESCALE CONFIGURATION
# =============================================================================
# Get API key from: https://telscale.com/dashboard/api
TELESCALE_API_KEY=
TELESCALE_WEBHOOK_SECRET=

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Enable email notifications
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Enable automatic backups
ENABLE_BACKUPS=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=7
BACKUP_ENCRYPTION_KEY=
