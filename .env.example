# OpenClaw VPS - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Minimal setup: Only SETUP_MODE and the relevant key for your mode
# =============================================================================

# =============================================================================
# REQUIRED - Setup Mode
# =============================================================================
# Choose your setup mode:
#   1 = Tailscale VPN (most private, no ports exposed)
#   2 = Cloudflare Tunnel (easy access, no VPN app needed)
#   3 = Cloudflare Proxy (traditional reverse proxy)
# =============================================================================
SETUP_MODE=1

# =============================================================================
# MODE 1: Tailscale Authentication
# Get your auth key from: https://login.tailscale.com/admin/settings/keys
# The key starts with 'tskey-auth-'
# =============================================================================
TAILSCALE_AUTH_KEY=tskey-auth-kffdsafdsa

# Custom hostname (optional - leave empty for auto-generated tailxxxx.ts.net)
TAILSCALE_FQDN=

# =============================================================================
# MODES 2 & 3: Cloudflare Configuration
# =============================================================================
# Your domain name
DOMAIN=example.com

# Cloudflare API Token
# Mode 2 (Tunnel): Account > Cloudflare Tunnel > Edit
# Mode 3 (Proxy): Zone > DNS > Edit
CLOUDFLARE_API_TOKEN=

# Cloudflare Zone ID (found in Cloudflare Dashboard > Domain > Overview > API)
CLOUDFLARE_ZONE_ID=

# Subdomain for OpenClaw access (e.g., 'openclaw' creates openclaw.example.com)
CLOUDFLARE_TUNNEL_SUBDOMAIN=openclaw

# =============================================================================
# OPTIONAL - Admin Credentials
# =============================================================================
# Admin username for web dashboard (default: admin)
ADMIN_USERNAME=admin

# Admin password (leave empty to auto-generate)
ADMIN_PASSWORD=
